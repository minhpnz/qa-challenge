# Copy to .env for local runs. CI injects these as environment variables / secrets.
# Nothing environment-specific is ever hardcoded in a spec.

# Which environment profile to resolve from config/environments.ts (local | staging | production)
TEST_ENV=production

# Optional per-run overrides of the resolved profile
# BASE_URL=https://www.demoblaze.com
# API_BASE_URL=https://api.demoblaze.com

# Execution knobs. Leave blank for the defaults (workers: auto, retries: 0 local / 2 on CI).
# RETRIES=0 is valid and means "fail fast, no retries".
HEADLESS=true
WORKERS=
RETRIES=
ACTION_TIMEOUT_MS=10000
EXPECT_TIMEOUT_MS=7000
TEST_TIMEOUT_MS=60000

# Artifacts: on | off | retain-on-failure | on-first-retry
TRACE=on-first-retry
VIDEO=on-first-retry
SCREENSHOT=only-on-failure

# Password used for the ephemeral accounts the framework registers per test
TEST_USER_PASSWORD=Passw0rd!QA

# Performance budgets (ms) — asserted by tests/performance
PERF_BUDGET_TTFB_MS=1500
PERF_BUDGET_DOM_CONTENT_LOADED_MS=4000
PERF_BUDGET_PAGE_LOAD_MS=6000
PERF_BUDGET_API_P95_MS=1500
PERF_API_SAMPLES=20
