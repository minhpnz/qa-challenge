{
  "name": "demoblaze-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E automation framework for demoblaze.com — UI, API, regression and performance layers on Playwright + TypeScript",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:cross-browser": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:mobile": "playwright test --project=ui-mobile-chrome --project=ui-mobile-safari",
    "test:api": "playwright test --project=api",
    "test:perf": "playwright test --project=performance",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:debug": "PWDEBUG=1 playwright test --project=ui-chromium --workers=1",
    "test:ci": "playwright test --project=ui-chromium --project=api",
    "codegen": "playwright codegen https://www.demoblaze.com",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
